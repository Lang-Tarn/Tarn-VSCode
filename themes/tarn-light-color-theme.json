{
  "$schema": "vscode://schemas/color-theme",
  "name": "Tarn Light",
  "type": "light",
  "semanticHighlighting": false,
  "colors": {
    "foreground": "#3a3a3a",
    "descriptionForeground": "#7a7a78",
    "focusBorder": "#c8c8c6",
    "widget.shadow": "#0000000d",
    "selection.background": "#e2e2e0",
    "textLink.foreground": "#2f5fa8",
    "textLink.activeForeground": "#1f4a8a",
    "textCodeBlock.background": "#f6f6f5",
    "textPreformat.foreground": "#2b2b2b",
    "textBlockQuote.background": "#fafaf9",
    "textBlockQuote.border": "#e2e2e0",

    "editor.background": "#ffffff",
    "editor.foreground": "#2b2b2b",
    "editorCursor.foreground": "#111111",
    "editor.lineHighlightBackground": "#fafaf9",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#e3e3e1",
    "editor.inactiveSelectionBackground": "#eeeeec",
    "editor.selectionHighlightBackground": "#ededeb",
    "editor.wordHighlightBackground": "#efefed",
    "editor.wordHighlightStrongBackground": "#e8e8e6",
    "editor.findMatchBackground": "#f1dfae",
    "editor.findMatchHighlightBackground": "#f6eed6",
    "editor.rangeHighlightBackground": "#f7f7f5",
    "editorLineNumber.foreground": "#c8c8c6",
    "editorLineNumber.activeForeground": "#6e6e6e",
    "editorWhitespace.foreground": "#e3e3e1",
    "editorIndentGuide.background1": "#f0f0ee",
    "editorIndentGuide.activeBackground1": "#d6d6d4",
    "editorRuler.foreground": "#f0f0ee",
    "editorBracketMatch.background": "#ececea",
    "editorBracketMatch.border": "#d0d0ce",
    "editorBracketHighlight.foreground1": "#8a8a88",
    "editorBracketHighlight.foreground2": "#8a8a88",
    "editorBracketHighlight.foreground3": "#8a8a88",
    "editorGutter.background": "#ffffff",
    "editorGutter.modifiedBackground": "#d9b56a",
    "editorGutter.addedBackground": "#8cbc9a",
    "editorGutter.deletedBackground": "#d98a84",
    "editorInlayHint.foreground": "#a8a8a6",
    "editorInlayHint.background": "#00000000",
    "editorCodeLens.foreground": "#a8a8a6",
    "editorError.foreground": "#c4362c",
    "editorWarning.foreground": "#b8862a",
    "editorInfo.foreground": "#2f5fa8",
    "editorUnnecessaryCode.opacity": "#00000066",
    "editorOverviewRuler.border": "#00000000",
    "editorWidget.background": "#ffffff",
    "editorWidget.border": "#e6e6e6",
    "editorHoverWidget.background": "#ffffff",
    "editorHoverWidget.border": "#e6e6e6",
    "editorSuggestWidget.background": "#ffffff",
    "editorSuggestWidget.border": "#e6e6e6",
    "editorSuggestWidget.foreground": "#2b2b2b",
    "editorSuggestWidget.selectedBackground": "#f0f0ee",
    "editorSuggestWidget.selectedForeground": "#111111",
    "editorSuggestWidget.highlightForeground": "#111111",
    "editorSuggestWidget.focusHighlightForeground": "#111111",
    "editorGroup.border": "#ececea",
    "editorGroupHeader.tabsBackground": "#fafaf9",
    "editorGroupHeader.tabsBorder": "#ececea",
    "peekView.border": "#e6e6e6",
    "peekViewEditor.background": "#fcfcfb",
    "peekViewResult.background": "#fafaf9",
    "peekViewTitle.background": "#fafaf9",

    "tab.activeBackground": "#ffffff",
    "tab.activeForeground": "#111111",
    "tab.activeBorderTop": "#111111",
    "tab.inactiveBackground": "#fafaf9",
    "tab.inactiveForeground": "#8a8a88",
    "tab.border": "#ececea",
    "tab.hoverBackground": "#f5f5f4",

    "titleBar.activeBackground": "#fafaf9",
    "titleBar.activeForeground": "#3a3a3a",
    "titleBar.inactiveBackground": "#fafaf9",
    "titleBar.inactiveForeground": "#a8a8a6",
    "titleBar.border": "#ececea",

    "activityBar.background": "#fafaf9",
    "activityBar.foreground": "#2b2b2b",
    "activityBar.inactiveForeground": "#b0b0ae",
    "activityBar.border": "#ececea",
    "activityBar.activeBorder": "#111111",
    "activityBarBadge.background": "#111111",
    "activityBarBadge.foreground": "#ffffff",

    "sideBar.background": "#fafaf9",
    "sideBar.foreground": "#3a3a3a",
    "sideBar.border": "#ececea",
    "sideBarTitle.foreground": "#6e6e6e",
    "sideBarSectionHeader.background": "#fafaf9",
    "sideBarSectionHeader.foreground": "#3a3a3a",
    "sideBarSectionHeader.border": "#ececea",

    "list.activeSelectionBackground": "#ececea",
    "list.activeSelectionForeground": "#111111",
    "list.inactiveSelectionBackground": "#f0f0ee",
    "list.inactiveSelectionForeground": "#111111",
    "list.hoverBackground": "#f3f3f1",
    "list.focusOutline": "#d0d0ce",
    "list.highlightForeground": "#111111",
    "list.errorForeground": "#c4362c",
    "list.warningForeground": "#a86a12",
    "tree.indentGuidesStroke": "#e2e2e0",

    "statusBar.background": "#fafaf9",
    "statusBar.foreground": "#6e6e6e",
    "statusBar.border": "#ececea",
    "statusBar.noFolderBackground": "#fafaf9",
    "statusBar.debuggingBackground": "#111111",
    "statusBar.debuggingForeground": "#ffffff",
    "statusBarItem.hoverBackground": "#efefed",
    "statusBarItem.remoteBackground": "#fafaf9",
    "statusBarItem.remoteForeground": "#3a3a3a",

    "panel.background": "#ffffff",
    "panel.border": "#ececea",
    "panelTitle.activeForeground": "#111111",
    "panelTitle.activeBorder": "#111111",
    "panelTitle.inactiveForeground": "#8a8a88",

    "input.background": "#ffffff",
    "input.border": "#e2e2e0",
    "input.foreground": "#2b2b2b",
    "input.placeholderForeground": "#b0b0ae",
    "inputOption.activeBorder": "#111111",
    "dropdown.background": "#ffffff",
    "dropdown.border": "#e2e2e0",
    "checkbox.border": "#d0d0ce",
    "button.background": "#111111",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#2b2b2b",
    "button.secondaryBackground": "#f0f0ee",
    "button.secondaryForeground": "#111111",
    "button.secondaryHoverBackground": "#e6e6e4",
    "badge.background": "#ececea",
    "badge.foreground": "#3a3a3a",
    "progressBar.background": "#111111",
    "scrollbar.shadow": "#00000000",
    "scrollbarSlider.background": "#0000000f",
    "scrollbarSlider.hoverBackground": "#0000001c",
    "scrollbarSlider.activeBackground": "#00000028",

    "notifications.background": "#ffffff",
    "notifications.border": "#e6e6e6",
    "notificationCenterHeader.background": "#fafaf9",
    "quickInput.background": "#ffffff",
    "pickerGroup.border": "#ececea",
    "pickerGroup.foreground": "#8a8a88",
    "breadcrumb.foreground": "#8a8a88",
    "breadcrumb.focusForeground": "#111111",
    "breadcrumb.activeSelectionForeground": "#111111",

    "gitDecoration.modifiedResourceForeground": "#a86a12",
    "gitDecoration.untrackedResourceForeground": "#2f7d4f",
    "gitDecoration.addedResourceForeground": "#2f7d4f",
    "gitDecoration.deletedResourceForeground": "#c4362c",
    "gitDecoration.conflictingResourceForeground": "#8e4a9e",
    "gitDecoration.ignoredResourceForeground": "#b0b0ae",

    "terminal.background": "#ffffff",
    "terminal.foreground": "#2b2b2b",
    "terminalCursor.foreground": "#111111",
    "terminal.selectionBackground": "#e3e3e1",
    "terminal.ansiBlack": "#3a3a3a",
    "terminal.ansiRed": "#c4362c",
    "terminal.ansiGreen": "#2f7d4f",
    "terminal.ansiYellow": "#a86a12",
    "terminal.ansiBlue": "#2f5fa8",
    "terminal.ansiMagenta": "#8e4a9e",
    "terminal.ansiCyan": "#2a7a7a",
    "terminal.ansiWhite": "#8a8a88",
    "terminal.ansiBrightBlack": "#6e6e6e",
    "terminal.ansiBrightRed": "#c4362c",
    "terminal.ansiBrightGreen": "#2f7d4f",
    "terminal.ansiBrightYellow": "#a86a12",
    "terminal.ansiBrightBlue": "#2f5fa8",
    "terminal.ansiBrightMagenta": "#8e4a9e",
    "terminal.ansiBrightCyan": "#2a7a7a",
    "terminal.ansiBrightWhite": "#111111"
  },
  "tokenColors": [
    { "scope": ["source", "variable", "variable.other"], "settings": { "foreground": "#2b2b2b" } },
    { "scope": ["comment", "punctuation.definition.comment", "comment.line.shebang"], "settings": { "foreground": "#a3a3a1", "fontStyle": "italic" } },
    {
      "scope": ["keyword", "keyword.control", "storage", "storage.type", "storage.modifier", "keyword.operator.logical", "keyword.operator.new"],
      "settings": { "foreground": "#2f5fa8" }
    },
    {
      "scope": ["keyword.operator", "keyword.operator.optional", "keyword.operator.pattern", "keyword.operator.assignment", "punctuation.separator"],
      "settings": { "foreground": "#7a7a78" }
    },
    { "scope": ["punctuation", "meta.brace", "punctuation.section.braces"], "settings": { "foreground": "#8a8a88" } },
    {
      "scope": ["entity.name.type", "support.type", "support.class", "entity.name.class", "entity.name.namespace", "entity.other.inherited-class"],
      "settings": { "foreground": "#111111" }
    },
    { "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function"], "settings": { "foreground": "#111111" } },
    { "scope": ["variable.other.declaration", "variable.parameter"], "settings": { "foreground": "#111111" } },
    { "scope": ["variable.other.property", "variable.other.member", "support.variable.property"], "settings": { "foreground": "#3a3a3a" } },
    { "scope": ["variable.other.enummember", "variable.other.constant"], "settings": { "foreground": "#111111" } },
    { "scope": ["variable.language", "variable.language.self", "variable.language.this"], "settings": { "foreground": "#7a7a78", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#3f7a54" } },
    {
      "scope": ["punctuation.section.interpolation", "punctuation.definition.template-expression", "meta.interpolation punctuation"],
      "settings": { "foreground": "#8a8a88" }
    },
    { "scope": ["meta.interpolation", "meta.embedded"], "settings": { "foreground": "#2b2b2b" } },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character", "constant.character.escape", "support.constant"],
      "settings": { "foreground": "#a86a12" }
    },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#c4362c" } },
    { "scope": ["markup.heading", "markup.bold"], "settings": { "foreground": "#111111", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#3f7a54" } },
    { "scope": ["markup.underline.link"], "settings": { "foreground": "#2f5fa8" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#2f7d4f" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#c4362c" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#a86a12" } }
  ]
}
