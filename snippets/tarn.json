{
  "import": {
    "prefix": "import",
    "description": "Import a module: one of your .tr files, or the standard library",
    "body": [
      "import ${1:module}",
      "$0"
    ]
  },
  "from import": {
    "prefix": "from",
    "description": "Import names from a module: from geometry import Point",
    "body": [
      "from ${1:module} import ${2:name}",
      "$0"
    ]
  },
  "now": {
    "prefix": "now",
    "description": "The current UTC date and time (needs `import time`)",
    "body": [
      "val ${1:now} = time.now()$0"
    ]
  },
  "timeit": {
    "prefix": "timeit",
    "description": "Measure how long some code takes (needs `import time`)",
    "body": [
      "val ${1:start} = time.monotonic_ms()",
      "$0",
      "print(f\"took {time.monotonic_ms() - $1} ms\")"
    ]
  },
  "main": {
    "prefix": "main",
    "description": "Program entry point",
    "body": [
      "fn main():",
      "\t${0:print(\"hello\")}"
    ]
  },
  "function": {
    "prefix": "fn",
    "description": "Function with a return type",
    "body": [
      "fn ${1:name}(${2:x}: ${3:Int}) -> ${4:Int}:",
      "\t${0:return $2}"
    ]
  },
  "generic function": {
    "prefix": "fngen",
    "description": "Generic function: works for any T that supports what it does with one",
    "body": [
      "fn ${1:name}[${2:T}](${3:x}: $2) -> $2:",
      "\t${0:return $3}"
    ]
  },
  "procedure": {
    "prefix": "fnu",
    "description": "Function that returns nothing",
    "body": [
      "fn ${1:name}(${2}):",
      "\t${0:pass}"
    ]
  },
  "struct": {
    "prefix": "struct",
    "description": "Struct with a field and a method",
    "body": [
      "struct ${1:Name}:",
      "\t${2:var} ${3:value}: ${4:Int}",
      "",
      "\tfn ${5:describe}(self) -> String:",
      "\t\t${0:return f\"$1({self.$3})\"}"
    ]
  },
  "generic struct": {
    "prefix": "structgen",
    "description": "Generic struct holding a T",
    "body": [
      "struct ${1:Box}[${2:T}]:",
      "\t${3:var} ${4:value}: $2",
      "",
      "\tfn ${5:get}(self) -> $2:",
      "\t\t${0:return self.$4}"
    ]
  },
  "interface": {
    "prefix": "interface",
    "description": "An interface: the methods a type needs to fit it",
    "body": [
      "interface ${1:Shape}:",
      "\tfn ${2:area}(self) -> ${3:Float}",
      "$0"
    ]
  },
  "bounded function": {
    "prefix": "fnbound",
    "description": "Generic function whose T fits an interface: fn total[T: Shape](xs: List[T])",
    "body": [
      "fn ${1:total}[${2:T}: ${3:Shape}](${4:xs}: List[$2]) -> ${5:Float}:",
      "\t${0:pass}"
    ]
  },
  "operator": {
    "prefix": "operator",
    "description": "An operator function: fn +(self, other: T) -> T (also - * / % == <=> [] []=)",
    "body": [
      "fn ${1|+,-,*,/,%,==,<=>,[],[]=|}(self, ${2:other}: ${3:T}) -> ${4:T}:",
      "    $0"
    ]
  },
  "to_string": {
    "prefix": "tostring",
    "description": "How print and f-strings show this type",
    "body": [
      "fn to_string(self) -> String:",
      "    return f\"${1}\"$0"
    ]
  },
  "enum": {
    "prefix": "enum",
    "description": "Enum whose variants carry data",
    "body": [
      "enum ${1:Shape}:",
      "\t${2:Circle}(${3:radius}: ${4:Float})",
      "\t${5:Empty}",
      "$0"
    ]
  },
  "match": {
    "prefix": "match",
    "description": "match on a value (every case must be handled)",
    "body": [
      "match ${1:value}:",
      "\tcase ${2:_}:",
      "\t\t${0:pass}"
    ]
  },
  "case": {
    "prefix": "case",
    "description": "A case of a match",
    "body": [
      "case ${1:pattern}:",
      "\t${0:pass}"
    ]
  },
  "if": {
    "prefix": "if",
    "description": "if block",
    "body": [
      "if ${1:condition}:",
      "\t${0:pass}"
    ]
  },
  "ifelse": {
    "prefix": "ife",
    "description": "if / else",
    "body": [
      "if ${1:condition}:",
      "\t${2:pass}",
      "else:",
      "\t${0:pass}"
    ]
  },
  "elif": {
    "prefix": "elif",
    "description": "elif branch",
    "body": [
      "elif ${1:condition}:",
      "\t${0:pass}"
    ]
  },
  "if not null": {
    "prefix": "ifnn",
    "description": "Run a block only when a nullable value isn't null (it's smart-cast inside)",
    "body": [
      "if ${1:value} != null:",
      "\t${0:print($1)}"
    ]
  },
  "or return": {
    "prefix": "orret",
    "description": "Unwrap a nullable value, or return when it's null",
    "body": [
      "val ${1:name} = ${2:maybe} ?: return$0"
    ]
  },
  "while": {
    "prefix": "while",
    "description": "while loop",
    "body": [
      "while ${1:condition}:",
      "\t${0:pass}"
    ]
  },
  "for range": {
    "prefix": "for",
    "description": "Loop over a range of numbers",
    "body": [
      "for ${1:i} in ${2:0}..${3:n}:",
      "\t${0:print($1)}"
    ]
  },
  "for each": {
    "prefix": "foreach",
    "description": "Loop over a list",
    "body": [
      "for ${1:item} in ${2:items}:",
      "\t${0:print($1)}"
    ]
  },
  "val": {
    "prefix": "val",
    "description": "Immutable variable",
    "body": [
      "val ${1:name} = ${0:value}"
    ]
  },
  "var": {
    "prefix": "var",
    "description": "Mutable variable",
    "body": [
      "var ${1:name} = ${0:value}"
    ]
  },
  "list": {
    "prefix": "list",
    "description": "Empty typed list",
    "body": [
      "val ${1:items}: List[${2:Int}] = []"
    ]
  },
  "print f-string": {
    "prefix": "printf",
    "description": "print an f-string",
    "body": [
      "print(f\"${1:value} = {${2:$1}}\")"
    ]
  },
  "shebang": {
    "prefix": "#!",
    "description": "Make the file directly executable",
    "body": [
      "#!/usr/bin/env tarn",
      "$0"
    ]
  },
  "map": {
    "prefix": "map",
    "description": "A map from keys to values",
    "body": [
      "val ${1:counts}: Map[${2:String}, ${3:Int}] = {}$0"
    ]
  },
  "count": {
    "prefix": "count",
    "description": "Count how often each value occurs, in a map",
    "body": [
      "val ${1:counts}: Map[${2:String}, Int] = {}",
      "for ${3:x} in ${4:items}:",
      "\t$1[$3] = $1.get($3, 0) + 1$0"
    ]
  },
  "formap": {
    "prefix": "formap",
    "description": "Loop over a map's keys and values (in insertion order)",
    "body": [
      "for ${1:key}, ${2:value} in ${3:m}:",
      "\t$0"
    ]
  },
  "hash": {
    "prefix": "hash",
    "description": "`fn ==` and `fn hash`, so a struct can be a map key",
    "body": [
      "fn ==(self, other: ${1:Self}) -> Bool:",
      "\treturn self.${2:x} == other.$2",
      "",
      "fn hash(self) -> Int:",
      "\treturn hash(self.$2)$0"
    ]
  },
  "readlines": {
    "prefix": "readlines",
    "description": "Loop over the lines of a file (needs `import fs`)",
    "body": [
      "for ${1:line} in fs.read_lines(\"${2:file.txt}\"):",
      "\t$0"
    ]
  },
  "Lambda": {
    "prefix": "lambda",
    "body": [
      "fn(${1:x}) -> ${2:$1}"
    ],
    "description": "A one-line lambda: fn(x) -> expression"
  },
  "Function that can fail": {
    "prefix": "fnres",
    "body": [
      "fn ${1:name}(${2:text}: ${3:String}) -> Result[${4:Int}, ${5:String}]:",
      "\tval ${6:n} = ${7:$2.to_int_or_null()} ?: return Err(${8:\"not a number\"})",
      "\treturn Ok(${0:$6})"
    ],
    "description": "A function returning a Result: Ok(value) or Err(error)"
  },
  "Match on a Result": {
    "prefix": "matchres",
    "body": [
      "match ${1:result}:",
      "\tcase Ok(${2:value}):",
      "\t\t${3:print($2)}",
      "\tcase Err(${4:error}):",
      "\t\t${0:print($4)}"
    ],
    "description": "Handle both outcomes of a Result"
  },
  "Start a task": {
    "prefix": "spawn",
    "body": [
      "val ${1:task} = spawn(fn() -> ${2:work()})",
      "$0",
      "val ${3:result} = $1.join()!!"
    ],
    "description": "Run a function alongside this code, as a task, and wait for its result"
  },
  "Tasks for a list": {
    "prefix": "spawnall",
    "body": [
      "val ${1:tasks} = ${2:items}.map(fn(${3:x}) -> spawn(fn() -> ${4:work}($3)))",
      "for ${5:t} in $1:",
      "\t${0:print($5.join()!!)}"
    ],
    "description": "A task for each element, then wait for them in order"
  },
  "Worker over a channel": {
    "prefix": "channel",
    "body": [
      "val ${1:jobs}: Channel[${2:Int}] = Channel.buffered(${3:100})",
      "val ${4:consume} = fn():",
      "\tfor ${5:job} in $1:",
      "\t\t${0:print($5)}",
      "val ${6:worker} = spawn($4)",
      "for ${7:x} in ${8:items}:",
      "\t$1.send($7)",
      "$1.close()",
      "$6.join()!!"
    ],
    "description": "A buffered channel: send values, close it, and a task receives them with `for x in jobs:`"
  },
  "Mutex": {
    "prefix": "mutex",
    "body": [
      "val ${1:state}: Mutex[${2:Map[String, Int]}] = Mutex(${3:{\\}})",
      "$1.lock(fn(${4:m}) -> ${0:$4.len()})"
    ],
    "description": "A value tasks share and change one at a time: `lock` runs a function on it"
  },
  "drop method": {
    "prefix": "drop",
    "body": [
      "fn drop(self):",
      "\t${0:pass}"
    ],
    "description": "Runs when the last reference to the value goes away (a variable keeps it until the end of its block)"
  },
  "TCP connection": {
    "prefix": "connect",
    "body": [
      "val ${1:conn} = net.connect(\"${2:127.0.0.1}\", ${3:8080})?",
      "$1.write(\"${4:hello}\".encode())?",
      "val ${5:reply} = $1.read(${6:4096})?.decode()",
      "$0"
    ],
    "description": "Connect, send text, read the reply (needs `import net`, in a function returning a Result)"
  },
  "Lambda with a block": {
    "prefix": "fnval",
    "body": [
      "val ${1:name} = fn(${2:x}: ${3:Int}) -> ${4:Int}:",
      "\t${0:return $2}"
    ],
    "description": "A lambda with a block body, in a variable"
  },
  "Static method": {
    "prefix": "fnstatic",
    "body": [
      "fn ${1:new}(${2:value}: ${3:Int}) -> ${4:Point}:",
      "\t${0:return $4($2)}"
    ],
    "description": "A static method (no `self`), called on the type: `Type.new(...)`"
  },
  "match as a value": {
    "prefix": "matchval",
    "body": [
      "val ${1:result} = match ${2:value}:",
      "\tcase ${3:pattern}: ${4:value}",
      "\tcase _: ${0:other}"
    ],
    "description": "A `match` that gives a value"
  },
  "Iterator": {
    "prefix": "iterator",
    "body": [
      "struct ${1:Name}(Iterator[${2:Int}]):",
      "\tvar ${3:at}: Int",
      "",
      "\tfn next(self) -> $2?:",
      "\t\t${0:return null}"
    ],
    "description": "A type `for` can loop over, with the `Iterator` methods (`map`, `filter`, `to_list`...)"
  },
  "Default method": {
    "prefix": "fndefault",
    "body": [
      "fn ${1:describe}(self) -> ${2:String}:",
      "\t${0:return \"\"}"
    ],
    "description": "A default method in an interface: every type that fits gets it, unless it has its own"
  },
  "comptime for": {
    "prefix": "comptimefor",
    "body": [
      "comptime for ${1:f} in fields(${2:T}):",
      "\t${0:pass}"
    ],
    "description": "Repeat code for each field of a struct, while compiling (`f.get(value)` reads the field)"
  },
  "describe": {
    "prefix": "fnfields",
    "body": [
      "fn ${1:describe}[T](value: T) -> String:",
      "\tval parts: List[String] = []",
      "\tcomptime for f in fields(T):",
      "\t\tparts.push(f\"{f.name}={f.get(value)}\")",
      "\treturn parts.join(\", \")"
    ],
    "description": "A generic function that loops over a struct's fields while compiling"
  },
  "comptime match": {
    "prefix": "comptimematch",
    "body": [
      "comptime match ${1:T}:",
      "\tcase ${2:Int}:",
      "\t\t${3:pass}",
      "\tcase _:",
      "\t\t${0:pass}"
    ],
    "description": "Pick code by type, in each copy of generic code"
  },
  "attribute": {
    "prefix": "attribute",
    "body": [
      "attribute ${1:name}(${2:value}: ${3:String})"
    ],
    "description": "Declare an attribute, written `@name(...)` on declarations and read while compiling"
  },
  "Function": {
    "prefix": "fnfunction",
    "body": [
      "fn ${1:route}[H: Function](${2:handler}: H):",
      "\tcomptime val ${3:a} = attribute(H, ${4:get}) ?: compile_error(f\"`{type_name(H)}` needs `@${4:get}`\")",
      "\t${0:pass}"
    ],
    "description": "A function taking another function by name, reading its attributes and parameters while compiling"
  }
}
